{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  }
}
