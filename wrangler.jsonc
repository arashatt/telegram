{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  // Public OIDC client id — it travels in the authorization URL, so it is a
  // plain var. TELEGRAM_CLIENT_SECRET is a secret and is never set here.
  "vars": {
    "TELEGRAM_CLIENT_ID": "8928298590"
  },
  // Per-IP caps. Chat and extraction each cost a Workers AI call, so they are
  // the expensive endpoints to protect; submissions are rarer and stricter.
  // "period" only accepts 10 or 60.
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
