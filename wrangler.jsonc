{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Without this, "single-page-application" makes the asset router answer
    // browser navigations to /api/* with index.html before the Worker runs —
    // which sent the sign-in popup and the OIDC callback to the home page.
    // API calls made with fetch() were unaffected, so it only broke the two
    // routes that are real navigations.
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // The shop owner's dashboard's database. The id is a resource identifier,
  // not a credential — reaching this database still needs Cloudflare account
  // auth — which is why it belongs in config rather than in the secrets panel.
  //
  // There is no migration step: the Worker creates its own tables on the
  // first request that needs one. See worker/schema.js.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-dashboard",
      "database_id": "a3768ed5-e028-440a-b590-33b50e430b16"
    }
  ],
  // No "vars" block on purpose. Values declared here overwrite dashboard-set
  // variables on every deploy, so runtime configuration lives entirely in
  // Cloudflare's "Variables and Secrets" panel instead:
  //   TELEGRAM_BOT_TOKEN      (secret)  deliver briefs
  //   TELEGRAM_CHAT_ID        (secret)  where briefs land
  //   TELEGRAM_CLIENT_SECRET  (secret)  Telegram sign-in
  //   ANTHROPIC_API_KEY       (secret)  optional — Claude answers the intake
  // Optional overrides documented in .dev.vars.example.
  // Per-IP caps. Chat and extraction each cost a Workers AI call, so they are
  // the expensive endpoints to protect; submissions are rarer and stricter.
  // "period" only accepts 10 or 60.
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 8, "period": 60 }
    },
    // The dashboard: reads are cheap but a signed-in person clicking around
    // makes a lot of them, and the automation's ingest batches share this cap.
    {
      "name": "APP_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
