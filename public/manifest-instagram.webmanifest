{
  "id": "/instagram",
  "name": "Instagram DM Automation",
  "short_name": "DM Intake",
  "description": "Describe the Instagram automation you want built and get a scoped quote. Catalog browsing and orders inside DMs, saved replies, order records and a dashboard.",
  "start_url": "/instagram",
  "scope": "/instagram",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/instagram-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/instagram-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/instagram-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon-instagram.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/instagram-narrow-1.jpg",
      "sizes": "824x1784",
