# Copy to .dev.vars for `npm run preview`, and set the same names as Worker
# secrets for production:  npx wrangler secret put TELEGRAM_BOT_TOKEN

# Required — where finished briefs are delivered. Token from @BotFather.
# (Sign-in no longer uses this; it uses the OIDC credentials below.)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your user id, a group id (negative, e.g. -1001234567890) or a channel id.
TELEGRAM_CHAT_ID=-1001234567890

# Optional — post into one topic of a forum-style group.
# TELEGRAM_TOPIC_ID=42

# Optional — mirror the raw JSON brief to your own endpoint as well.
# REQUIREMENTS_WEBHOOK_URL=https://example.com/hooks/bot-brief
# REQUIREMENTS_WEBHOOK_SECRET=sent-as-a-bearer-token

# --- Telegram sign-in (OpenID Connect) --------------------------------------
# Register the app with Telegram and set the redirect URI to
#   https://<your-domain>/api/auth/telegram/callback
#
# TELEGRAM_CLIENT_ID is public (it travels in the authorization URL) and is set
# in wrangler.jsonc under "vars". Only the secret belongs here:
TELEGRAM_CLIENT_SECRET=your-oidc-client-secret

# Optional overrides. The redirect URI is derived from the request origin
# unless you pin it, which you need to do behind a proxy or custom domain.
# TELEGRAM_REDIRECT_URI=https://example.com/api/auth/telegram/callback
# TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
# TELEGRAM_OIDC_SCOPE=openid

# Leave TELEGRAM_CLIENT_SECRET unset and sign-in is simply not offered — the
# button does not render and /api/auth/telegram/me reports configured:false.
