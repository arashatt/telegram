# LOCAL DEVELOPMENT ONLY. Copy this file to .dev.vars (gitignored) for
# `npm run preview`.
#
# In production these are NOT set from a file and NOT from wrangler.jsonc.
# They live in the Cloudflare dashboard:
#
#   Workers & Pages > your Worker > Settings > Variables and Secrets
#
# Add each as type "Secret" (encrypted, write-only) rather than "Text", then
# redeploy. Confirm the Worker can see them by opening /api/health, which
# reports which settings are present without revealing any value.

# --- Required: where finished briefs are delivered -------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your user id, or a group/channel id (negative, e.g. -1001234567890).
# The bot must be a member able to post there.
TELEGRAM_CHAT_ID=-1001234567890

# --- Required for Telegram sign-in (OpenID Connect) ------------------------
# Register the redirect URI with Telegram first:
#   https://<your-domain>/api/auth/telegram/callback
# Leave this unset and sign-in is simply not offered — no broken button.
TELEGRAM_CLIENT_SECRET=your-oidc-client-secret

# --- Optional --------------------------------------------------------------
# Public OIDC client id. Defaults to 8928298590 in code; set this only to
# point the site at a different Telegram app. Not a secret.
# TELEGRAM_CLIENT_ID=8928298590

# Pin the redirect URI (needed behind a proxy or custom domain); otherwise it
# is derived from the request origin.
# TELEGRAM_REDIRECT_URI=https://example.com/api/auth/telegram/callback
# TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
# TELEGRAM_OIDC_SCOPE=openid

# Post briefs into one topic of a forum-style group.
# TELEGRAM_TOPIC_ID=42

# Mirror the raw JSON brief to your own endpoint as well.
# REQUIREMENTS_WEBHOOK_URL=https://example.com/hooks/bot-brief
# REQUIREMENTS_WEBHOOK_SECRET=sent-as-a-bearer-token

# Claude answers the conversation and fills the form when this is set; without
# it the Worker uses the Workers AI binding, exactly as before. Add it in the
# dashboard as type "Secret" — it is a real credential and is billed per use.
# CLAUDE_API_KEY is read under the same meaning if you prefer that name.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Override the Claude model. Defaults to claude-opus-5.
# CLAUDE_MODEL=claude-opus-5

# Point the SDK at a gateway rather than the API. Unset in normal use.
# ANTHROPIC_BASE_URL=https://gateway.example.com/anthropic

# --- The shop owner's dashboard at /app ------------------------------------
# Who may create a shop, comma-separated. It grants that and nothing else — an
# admin who is not a member of a shop still cannot read that shop's orders.
# Leave it unset and no shop can be created, which is the right state until
# the D1 database exists.
#
# NOT the account number @userinfobot reports. Telegram's sign-in gives this
# site a subject id of its own, scoped to this site, and that is what the
# Worker compares against — a much longer number. Read it off /app: sign in
# and it is on screen, with a copy button. The variable's name is historical.
# ADMIN_TELEGRAM_IDS=7027960623470478911,7027960623470478912
#
# The database itself is not a variable: it is a binding, and it lives in
# wrangler.jsonc — see the commented d1_databases block there, and the README.

# --- Customers, invoices and getting paid ----------------------------------
# All optional. With none of these set, invoices can still be raised and read;
# there is simply no gateway to pay them through, and the payment page says so
# in words rather than showing a button that does nothing.
#
# Stripe. Both are needed or the gateway is not offered at all: without the
# webhook secret a payment could be started and never confirmed, which is worse
# than no button — the money leaves the payer and the invoice stays open.
# The webhook endpoint to register with Stripe is
#   https://<your-domain>/api/webhooks/stripe
# subscribed to checkout.session.completed (and the async_payment_* events if
# you accept bank debits).
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Zarinpal. The merchant id from your panel, a 36-character UUID.
# ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
#
# Zibal. The merchant code from your panel.
# ZIBAL_MERCHANT=zibal
#
# AMOUNTS ARE IN RIAL, NOT TOMAN. IRR has no minor unit, so an IRR invoice's
# amount is a whole number of Rial and that is exactly what both Iranian
# gateways are sent. Persian screens divide by ten to *show* Toman, which is
# what a customer reads a price in, and nothing else converts anywhere. The
# whole argument is in worker/gateways/rial.js.
#
# Which currency a Persian invoice starts in. Defaults to IRR; set it only if
# the studio invoices Persian customers in something else.
# PAYMENTS_CURRENCY_FA=IRR
#
# The public origin a gateway sends a payer back to. Derived from the request
# by default; set it only when a proxy makes the request origin wrong — the
# same reason TELEGRAM_REDIRECT_URI exists.
# SITE_ORIGIN=https://example.com

# Nothing extra is needed for the Instagram site at /instagram: it shares this
# Worker, these secrets and this delivery chat. Each brief's heading says which
# site it came from.

# Workers AI models — the fallback whenever Claude is unavailable, and the
# only models used when no Anthropic key is set.
# `npx wrangler ai models` lists what your account can run.
# CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# EXTRACT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
